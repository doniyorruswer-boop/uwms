# ==============================================================================
# UWMS — Docker Compose Muhiti Uchun Konfiguratsiya Fayli Namunasi (.env)
# ==============================================================================
# Ushbu faylni '.env' nomiga nusxalab, kerakli xavfsiz qiymatlarni kiriting:
# cp .env.docker.example .env
# docker compose up -d --build
# ==============================================================================

# -----------------
# 1. POSTGRESQL MA'LUMOTLAR BAZASI
# -----------------
POSTGRES_USER=uwms_admin
POSTGRES_PASSWORD=UWMS_Strong_Password_2026!
POSTGRES_DB=uwms_db
POSTGRES_PORT=5432

# -----------------
# 2. BACKEND (NESTJS) KONFIGURATSIYASI
# -----------------
PORT=4000
NODE_ENV=production
# Docker ichidagi tarmoqda db host nomi 'db' bo'ladi:
DATABASE_URL=postgresql://uwms_admin:UWMS_Strong_Password_2026!@db:5432/uwms_db?schema=public

# Xavfsizlik: Kamida 32 belgili murakkab maxfiy kalit
JWT_SECRET=super_secret_jwt_key_uwms_enterprise_production_2026_salt
JWT_EXPIRES_IN=7d

# Ruxsat etilgan frontend URL (CORS uchun)
CLIENT_URL=http://localhost

# Zaxira nusxalari saqlanadigan papka
BACKUP_DIR=/app/backups

# -----------------
# 3. FRONTEND (VITE + NGINX) KONFIGURATSIYASI
# -----------------
# Docker build vaqtida API proxy orqali /api ga so'rov jo'natiladi
VITE_API_URL=/api
FRONTEND_PORT=80
