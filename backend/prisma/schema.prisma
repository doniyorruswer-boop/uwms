datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  SUPER_ADMIN
  HEAD_WAREHOUSE
  MOL
  EMPLOYEE
  AUDITOR
  CHIEF_ACCOUNTANT
  COMMENDANT
  RECTOR
  VICE_RECTOR_FINANCE
}

enum ItemType {
  FIXED_ASSET
  CONSUMABLE
}

enum AssetStatus {
  NEW
  IN_USE
  IN_REPAIR
  WRITTEN_OFF
  MISSING
}

enum RequestStatus {
  SUBMITTED
  PENDING
  APPROVED_BY_PRORECTOR
  APPROVED_BY_RECTOR
  FINANCED_BY_ACCOUNTANT
  RECEIVED_AT_WAREHOUSE
  HANDED_TO_COMMENDANT
  FULFILLED
  REJECTED
  CANCELLED
  APPROVED_BY_HEAD
  APPROVED_BY_WAREHOUSE
}

enum MovementType {
  INCOMING
  OUTGOING
  TRANSFER
  WRITE_OFF
  RETURN
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AuditStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditRecordStatus {
  MATCHED
  MISSING
  RELOCATED
  UNEXPECTED
}

enum CampaignStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FundingSource {
  BYUDJET
  KONTRAKT_RIVOJLANTIRISH
  GRANT
}

model User {
  id           String      @id @default(uuid())
  fullName     String
  username     String      @unique
  email        String?     @unique
  password           String
  hashedRefreshToken String?
  mustChangePassword Boolean     @default(true)
  phone              String?
  position           String?     // Lavozim (Dekan, Kafedra mudiri, Laborant, Omborchi)
  role               RoleType    @default(EMPLOYEE)
  permissions        String[]    @default([])
  isActive           Boolean     @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  responsibleRooms      Room[]               @relation("RoomResponsible")
  responsibleInstances  ItemInstance[]       @relation("UserResponsibleInstances")
  submittedRequests     Request[]            @relation("UserRequests")
  approvedRequests      Request[]            @relation("ApproverRequests")
  executedMovements     StockMovement[]      @relation("MovementExecutor")
  executedHistories     AssetHistory[]       @relation("HistoryExecutor")
  createdAudits         InventoryAudit[]     @relation("AuditCreator")
  sentTransfers         TransferAcceptance[] @relation("TransferSender")
  receivedTransfers     TransferAcceptance[] @relation("TransferReceiver")
  repairRequests        RepairRecord[]       @relation("RepairRequester")
  approvedRepairs       RepairRecord[]       @relation("RepairApprover")
  createdWriteOffs      WriteOffRequest[]    @relation("WriteOffCreator")
  writeOffVotes         WriteOffMemberVote[]
  notifications         Notification[]
  systemLogs            SystemAuditLog[]
  backups               BackupRecord[]       @relation("UserBackups")
  labelReprints         LabelReprintLog[]    @relation("LabelReprints")
  depreciationRuns      DepreciationRun[]    @relation("DepreciationExecutors")
  signedArchives        DocumentArchive[]    @relation("UserDocumentSigned")
  cancelledArchives     DocumentArchive[]    @relation("UserDocumentCancelled")
  revokedStamps         DocumentStamp[]      @relation("DocumentStampRevoker")
  createdCampaigns      InventoryCampaign[]  @relation("CampaignCreator")
  assignedCampaigns     InventoryCampaign[]  @relation("CampaignAssignedAuditor")
  approvedCampaigns     InventoryCampaign[]  @relation("CampaignApprover")
  signingSessions       SigningSession[]     @relation("UserSigningSessions")
  createdSigningSessions SigningSession[]    @relation("CreatedSigningSessions")
  commendantRequests    Request[]            @relation("CommendantRequests")
  prorektorApprovedRequests  Request[]       @relation("ProrektorApprovedRequests")
  rectorApprovedRequests     Request[]       @relation("RectorApprovedRequests")
  accountantFinancedRequests Request[]       @relation("AccountantFinancedRequests")
  warehouseReceivedRequests  Request[]       @relation("WarehouseReceivedRequests")
  commendantHandedRequests   Request[]       @relation("CommendantHandedRequests")
  commendantBuildings        Building[]       @relation("BuildingCommendant")
  managedWarehouses          Warehouse[]      @relation("WarehouseManager")
  departingHandovers         ResponsibilityHandover[] @relation("DepartingHandovers")
  targetHandovers            ResponsibilityHandover[] @relation("TargetHandovers")
  commandantHandovers        ResponsibilityHandover[] @relation("CommandantHandovers")
  accountantHandovers        ResponsibilityHandover[] @relation("AccountantHandovers")
  approvedHandovers          ResponsibilityHandover[] @relation("ApprovedHandovers")

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("users")
}

model Department {
  id          String       @id @default(uuid())
  name        String
  code        String?      @unique
  type        String       @default("DEPARTMENT") // FACULTY, CHAIR, DIVISION, LAB
  parentId    String?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")

  buildingId  String?
  building    Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  users     User[]
  rooms     Room[]
  requests  Request[]
  quotas    DepartmentQuota[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@index([buildingId])
  @@map("departments")
}

model Building {
  id           String      @id @default(uuid())
  name         String      @unique
  code         String?     @unique
  floorsCount  Int         @default(4)
  address      String?
  description  String?
  commendantId String?
  commendant   User?       @relation("BuildingCommendant", fields: [commendantId], references: [id], onDelete: SetNull)

  rooms        Room[]
  departments  Department[]
  warehouses   Warehouse[]
  handovers    ResponsibilityHandover[] @relation("BuildingHandovers")

  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([deletedAt])
  @@index([commendantId])
  @@map("buildings")
}

model Room {
  id                String       @id @default(uuid())
  number            String
  name              String
  floor             Int          @default(1)
  buildingId        String?
  buildingRelation  Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  building          String       @default("Bosh bino")
  departmentId      String?
  department        Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  responsibleUserId String?
  responsibleUser   User?        @relation("RoomResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  itemInstances ItemInstance[]
  fromMovements StockMovement[]      @relation("MoveFromRoom")
  toMovements   StockMovement[]      @relation("MoveToRoom")
  fromTransfers TransferAcceptance[] @relation("TransferFromRoom")
  toTransfers   TransferAcceptance[] @relation("TransferToRoom")
  audits        InventoryAudit[]
  campaignScopes InventoryCampaignScope[]
  targetRequests Request[]            @relation("RequestTargetRoom")
  handovers      ResponsibilityHandover[] @relation("RoomHandovers")

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, number])
  @@index([departmentId])
  @@index([buildingId])
  @@index([building])
  @@index([responsibleUserId])
  @@index([deletedAt])
  @@map("rooms")
}

model Supplier {
  id             String         @id @default(uuid())
  name           String         // Korxona nomi
  inn            String?        // STIR / INN
  contractNumber String?        // Shartnoma raqami
  contractDate   DateTime?      // Shartnoma sanasi
  contactPerson  String?        // Mas'ul vakil
  phone          String?
  email          String?
  notes          String?

  invoices       Invoice[]
  itemInstances  ItemInstance[]
  movements      StockMovement[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("suppliers")
}

model Invoice {
  id            String         @id @default(uuid())
  invoiceNumber String         @unique // Hisob-faktura raqami
  invoiceDate   DateTime       @default(now())
  totalAmount   Decimal?       @db.Decimal(14, 2)
  notes         String?

  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  instances     ItemInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@map("invoices")
}

model Warehouse {
  id          String       @id @default(uuid())
  name        String
  code        String?      @unique
  buildingId  String?
  building    Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  managerId   String?
  manager     User?        @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  location    String?
  isMain      Boolean      @default(false)
  deletedAt   DateTime?

  stocks        Stock[]
  fromMovements StockMovement[] @relation("MoveFromWarehouse")
  toMovements   StockMovement[] @relation("MoveToWarehouse")
  transfers     TransferAcceptance[]
  handovers     ResponsibilityHandover[] @relation("WarehouseHandovers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buildingId])
  @@index([managerId])
  @@index([deletedAt])
  @@map("warehouses")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  items       Item[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("categories")
}

model Item {
  id            String    @id @default(uuid())
  name          String
  model         String?
  sku           String?   @unique
  itemType      ItemType  @default(FIXED_ASSET)
  unit          String    @default("DONA")
  minStockLimit Int       @default(5)
  description   String?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  instances     ItemInstance[]
  stocks        Stock[]
  requestItems  RequestItem[]
  movementItems StockMovementItem[]
  quotas        DepartmentQuota[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([itemType])
  @@index([deletedAt])
  @@map("items")
}

model ItemInstance {
  id                String      @id @default(uuid())
  inventoryNumber   String      @unique
  serialNumber      String?
  qrCode            String      @unique
  status            AssetStatus   @default(NEW)
  fundingSource     FundingSource @default(BYUDJET)
  purchaseDate      DateTime?
  purchasePrice     Decimal?      @db.Decimal(12, 2)
  warrantyMonths    Int         @default(12)
  depreciationRate  Float       @default(20.0) // Yillik amortizatsiya foizi
  notes             String?

  itemId            String
  item              Item        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  roomId            String?
  room              Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  responsibleUserId String?
  responsibleUser   User?       @relation("UserResponsibleInstances", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceId         String?
  invoice           Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  reprintCount      Int                  @default(0)
  lastReprintReason String?
  lastReprintedAt   DateTime?

  currentBookValue        Decimal?             @db.Decimal(12, 2)
  accumulatedDepreciation Decimal              @default(0) @db.Decimal(12, 2)
  lastDepreciatedAt       DateTime?

  histories           AssetHistory[]
  transfers           TransferAcceptance[]
  repairRecords       RepairRecord[]
  writeOffRequests    WriteOffRequest[]
  movementItems       StockMovementItem[]
  auditRecords        InventoryAuditRecord[]
  reprintLogs         LabelReprintLog[]
  depreciationRecords DepreciationRecord[]
  handoverActions     HandoverItemAction[] @relation("HandoverItemInstances")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([responsibleUserId])
  @@index([fundingSource])
  @@index([roomId])
  @@index([status])
  @@map("item_instances")
}

model LabelReprintLog {
  id            String       @id @default(uuid())
  assetId       String
  asset         ItemInstance @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reason        String
  reprintNumber Int
  printedById   String?
  printedBy     User?        @relation("LabelReprints", fields: [printedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([assetId])
  @@index([printedById])
  @@map("label_reprint_logs")
}

model AssetHistory {
  id             String       @id @default(uuid())
  assetId        String
  asset          ItemInstance @relation(fields: [assetId], references: [id], onDelete: Restrict)
  action         String       // KIRIM, BIRIKTIRILDI, KO'CHIRILDI, TAMIRLANDI, SPISANIE, QAYTARILDI
  fromLocation   String?
  toLocation     String?
  fromUser       String?
  toUser         String?
  referenceDoc   String?
  note           String?

  executedById   String?
  executedBy     User?        @relation("HistoryExecutor", fields: [executedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([executedById])
  @@index([createdAt])
  @@map("asset_histories")
}

model TransferAcceptance {
  id            String         @id @default(uuid())
  assetId       String
  asset         ItemInstance   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  status        TransferStatus @default(PENDING)
  note          String?
  isReturn      Boolean        @default(false)

  fromRoomId    String?
  fromRoom      Room?          @relation("TransferFromRoom", fields: [fromRoomId], references: [id])
  toRoomId      String?
  toRoom        Room?          @relation("TransferToRoom", fields: [toRoomId], references: [id])
  toWarehouseId String?
  toWarehouse   Warehouse?     @relation(fields: [toWarehouseId], references: [id])

  senderId      String
  sender        User           @relation("TransferSender", fields: [senderId], references: [id])
  receiverId    String?
  receiver      User?          @relation("TransferReceiver", fields: [receiverId], references: [id])

  acceptedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([assetId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("transfer_acceptances")
}


model Stock {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Int           @default(0)
  fundingSource FundingSource @default(BYUDJET)

  updatedAt DateTime @updatedAt

  @@unique([warehouseId, itemId, fundingSource])
  @@index([warehouseId])
  @@index([itemId])
  @@index([fundingSource])
  @@map("stocks")
}

model Request {
  id            String        @id @default(uuid())
  requestNumber String        @unique
  purpose       String
  status        RequestStatus @default(SUBMITTED)
  isOverQuota   Boolean       @default(false)
  specialApprovalNeeded Boolean @default(false)
  notes         String?
  approvalNote  String?

  // Financial and accounting allocations (Phase L1)
  fundingSource   FundingSource?
  subAccountCode  String?       // Masalan: "013", "060", "212"
  allocatedAmount Decimal?      @db.Decimal(14, 2)
  targetRoomId    String?
  targetRoom      Room?         @relation("RequestTargetRoom", fields: [targetRoomId], references: [id], onDelete: SetNull)
  commendantId    String?
  commendant      User?         @relation("CommendantRequests", fields: [commendantId], references: [id], onDelete: SetNull)

  // 7-step Workflow timestamps & signer IDs
  submittedAt            DateTime?     @default(now())
  prorektorApprovedAt    DateTime?
  prorektorApprovedById  String?
  prorektorApprovedBy    User?         @relation("ProrektorApprovedRequests", fields: [prorektorApprovedById], references: [id], onDelete: SetNull)
  rectorApprovedAt       DateTime?
  rectorApprovedById     String?
  rectorApprovedBy       User?         @relation("RectorApprovedRequests", fields: [rectorApprovedById], references: [id], onDelete: SetNull)
  accountantFinancedAt   DateTime?
  accountantFinancedById String?
  accountantFinancedBy   User?         @relation("AccountantFinancedRequests", fields: [accountantFinancedById], references: [id], onDelete: SetNull)
  warehouseReceivedAt    DateTime?
  warehouseReceivedById  String?
  warehouseReceivedBy    User?         @relation("WarehouseReceivedRequests", fields: [warehouseReceivedById], references: [id], onDelete: SetNull)
  commendantHandedAt     DateTime?
  commendantHandedById   String?
  commendantHandedBy     User?         @relation("CommendantHandedRequests", fields: [commendantHandedById], references: [id], onDelete: SetNull)
  fulfilledAt            DateTime?

  requesterId   String
  requester     User          @relation("UserRequests", fields: [requesterId], references: [id])
  departmentId  String?
  department    Department?   @relation(fields: [departmentId], references: [id])
  approvedById  String?
  approvedBy    User?         @relation("ApproverRequests", fields: [approvedById], references: [id])

  items RequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([departmentId])
  @@index([status])
  @@index([createdAt])
  @@map("requests")
}

model RequestItem {
  id           String  @id @default(uuid())
  requestId    String
  request      Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item    @relation(fields: [itemId], references: [id])
  requestedQty Int
  approvedQty  Int?

  @@index([requestId])
  @@index([itemId])
  @@map("request_items")
}

model StockMovement {
  id              String       @id @default(uuid())
  movementNumber  String       @unique
  movementType    MovementType
  referenceDoc    String?
  note            String?

  executedById    String
  executedBy      User         @relation("MovementExecutor", fields: [executedById], references: [id])

  fromRoomId      String?
  fromRoom        Room?        @relation("MoveFromRoom", fields: [fromRoomId], references: [id])
  toRoomId        String?
  toRoom          Room?        @relation("MoveToRoom", fields: [toRoomId], references: [id])

  fromWarehouseId String?
  fromWarehouse   Warehouse?   @relation("MoveFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?   @relation("MoveToWarehouse", fields: [toWarehouseId], references: [id])

  supplierId      String?
  supplier        Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber   String?
  fundingSource   FundingSource @default(BYUDJET)

  items StockMovementItem[]

  createdAt DateTime @default(now())

  @@index([executedById])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([movementType])
  @@index([fundingSource])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockMovementItem {
  id             String        @id @default(uuid())
  movementId     String
  movement       StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item          @relation(fields: [itemId], references: [id])
  itemInstanceId String?
  itemInstance   ItemInstance? @relation(fields: [itemInstanceId], references: [id])
  quantity       Int           @default(1)
  note           String?

  @@index([movementId])
  @@index([itemId])
  @@index([itemInstanceId])
  @@map("stock_movement_items")
}

model InventoryAudit {
  id           String      @id @default(uuid())
  auditNumber  String      @unique
  title        String
  status       AuditStatus @default(DRAFT)
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdById  String
  createdBy    User        @relation("AuditCreator", fields: [createdById], references: [id])
  roomId       String?
  room         Room?       @relation(fields: [roomId], references: [id])

  campaignId   String?
  campaign     InventoryCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  records InventoryAuditRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([createdById])
  @@index([campaignId])
  @@index([status])
  @@map("inventory_audits")
}

model InventoryAuditRecord {
  id             String            @id @default(uuid())
  auditId        String
  audit          InventoryAudit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemInstanceId String
  itemInstance   ItemInstance      @relation(fields: [itemInstanceId], references: [id])
  expectedRoomId String?
  foundRoomId    String?
  status         AuditRecordStatus @default(MATCHED)
  scannedAt      DateTime          @default(now())
  notes          String?

  @@index([auditId])
  @@index([itemInstanceId])
  @@index([status])
  @@map("inventory_audit_records")
}

model InventoryCampaign {
  id             String                   @id @default(uuid())
  campaignNumber String                   @unique // CMP-YYYY-XXXX
  title          String
  periodStart    DateTime
  periodEnd      DateTime
  status         CampaignStatus           @default(PLANNED)
  notes          String?

  createdById        String
  createdBy          User                     @relation("CampaignCreator", fields: [createdById], references: [id])

  orderNumber        String?                  // Rektor Farmoyishi / Buyrug'i raqami
  orderDate          DateTime?                // Rektor Buyrug'i sanasi
  assignedAuditorId  String?                  // Tayinlangan Mas'ul Auditor
  assignedAuditor    User?                    @relation("CampaignAssignedAuditor", fields: [assignedAuditorId], references: [id])
  approvedById       String?                  // Tasdiqlagan Rektor
  approvedBy         User?                    @relation("CampaignApprover", fields: [approvedById], references: [id])
  approvedAt         DateTime?                // Rektor QR orqali tasdiqlagan vaqt
  signatureHash      String?                  // Kriptografik imzo muhr xeshi

  scopes             InventoryCampaignScope[]
  audits             InventoryAudit[]

  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([assignedAuditorId])
  @@index([approvedById])
  @@map("inventory_campaigns")
}

model InventoryCampaignScope {
  id         String            @id @default(uuid())
  campaignId String
  campaign   InventoryCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  roomId     String
  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt  DateTime          @default(now())

  @@unique([campaignId, roomId])
  @@index([campaignId])
  @@index([roomId])
  @@map("inventory_campaign_scopes")
}

enum RepairStatus {
  PENDING
  IN_REPAIR
  COMPLETED
  UNREPAIRABLE
}

model RepairRecord {
  id               String       @id @default(uuid())
  repairNumber     String       @unique // REP-YYYY-XXXX
  assetId          String
  asset            ItemInstance @relation(fields: [assetId], references: [id], onDelete: Restrict)
  issueDescription String
  status           RepairStatus @default(PENDING)
  serviceProvider  String?      // Masalan: "TexnoServis MCHJ" yoki "OTM ustaxonasi"
  cost             Decimal?     @db.Decimal(12, 2)
  startDate        DateTime?
  completionDate   DateTime?
  actNumber        String?      // Ta'mirlash dalolatnomasi
  notes            String?

  requestedById    String
  requestedBy      User         @relation("RepairRequester", fields: [requestedById], references: [id])
  approvedById     String?
  approvedBy       User?        @relation("RepairApprover", fields: [approvedById], references: [id])

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([assetId])
  @@index([requestedById])
  @@index([status])
  @@map("repair_records")
}

enum WriteOffStatus {
  IN_REVIEW
  APPROVED
  REJECTED
}

enum VoteStatus {
  PENDING
  APPROVED
  REJECTED
}

model WriteOffRequest {
  id                  String               @id @default(uuid())
  actNumber           String               @unique // OS4-YYYY-XXXX
  assetId             String
  asset               ItemInstance         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reason              String
  technicalConclusion String?              // Texnik ekspertiza xulosasi
  status              WriteOffStatus       @default(IN_REVIEW)
  approvedAt          DateTime?

  createdById         String
  createdBy           User                 @relation("WriteOffCreator", fields: [createdById], references: [id])

  members             WriteOffMemberVote[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([assetId])
  @@index([createdById])
  @@index([status])
  @@map("write_off_requests")
}

model WriteOffMemberVote {
  id              String          @id @default(uuid())
  writeOffId      String
  writeOffRequest WriteOffRequest @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  roleName        String          // Masalan: "Komissiya raisi", "Bosh buxgalter", "Yurist", "Bosh mexanik"
  vote            VoteStatus      @default(PENDING)
  comment         String?
  votedAt         DateTime?

  @@unique([writeOffId, userId])
  @@index([writeOffId])
  @@index([userId])
  @@map("write_off_member_votes")
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  REQUEST
  TRANSFER
  AUDIT
  REPAIR
  WRITE_OFF
  QUOTA
}

model DepartmentQuota {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  monthlyLimit Int        @default(10)
  period       String     // YYYY-MM masalan "2026-09"
  usedQuantity Int        @default(0)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, itemId, period])
  @@index([departmentId])
  @@index([itemId])
  @@index([period])
  @@map("department_quotas")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?          // e.g. "/requests", "/repairs", "/quotas"
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SystemAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, APPROVE, REJECT, FULFILL, TRANSFER, RETURN, REPAIR, WRITE_OFF, QUOTA, HEMIS_SYNC, EXPORT
  entity    String   // Request, ItemInstance, DepartmentQuota, User, Room, Warehouse
  entityId  String?
  details   String?  // JSON text with parameters or changes
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("system_audit_logs")
}

model DocumentStamp {
  id               String            @id @default(uuid())
  docType          String            // OS_1, OS_2, INV_19, OS_4, MOL_TRANSFER, RETURN_ACT
  docNumber        String            @unique
  verificationHash String            @unique
  title            String
  signerName       String
  signerRole       String
  metadataJson     String            // JSON text with verified payload details
  isValid          Boolean           @default(true)
  revokedAt        DateTime?
  revokedReason    String?
  revokedById      String?
  revokedBy        User?             @relation("DocumentStampRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  archives         DocumentArchive[]
  signingSessions  SigningSession[]

  @@index([docType])
  @@index([docNumber])
  @@index([signerRole])
  @@index([createdAt])
  @@map("document_stamps")
}

enum DocumentArchiveStatus {
  DRAFT
  SIGNED
  CANCELLED
  ARCHIVED
}

model DocumentArchive {
  id            String                @id @default(uuid())
  docType       String                // OS_1, OS_2, OS_4, INV_19, MOL_TRANSFER, RETURN
  entityId      String                // ID of Request, ItemInstance, WriteOffRequest, etc.
  docNumber     String
  title         String
  version       Int                   @default(1)
  status        DocumentArchiveStatus @default(SIGNED)
  pdfPath       String?               // Stored file path (HTML/PDF snapshot)
  fileSize      Int?                  @default(0)
  checksum      String?               // SHA-256 xesh
  metadata      Json?                 // Rekvizitlar, buyumlar, tomonlar

  stampId       String?
  stamp         DocumentStamp?        @relation(fields: [stampId], references: [id], onDelete: SetNull)

  signedById    String?
  signedBy      User?                 @relation("UserDocumentSigned", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt      DateTime?             @default(now())

  cancelledById String?
  cancelledBy   User?                 @relation("UserDocumentCancelled", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime?
  cancelReason  String?
  handovers     ResponsibilityHandover[] @relation("HandoverDocumentArchive")

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([entityId])
  @@index([docType])
  @@index([docNumber])
  @@index([stampId])
  @@index([signedById])
  @@index([status])
  @@map("document_archives")
}

enum SigningSessionStatus {
  PENDING
  SCANNED
  SIGNED
  EXPIRED
  CANCELLED
}

model SigningSession {
  id             String               @id @default(uuid())
  sessionToken   String               @unique
  docNumber      String
  docType        String               // OS_1, OS_2, OS_4, INV_19, REQUEST, TRANSFER
  title          String
  departmentName String?
  roomName       String?
  itemSummary    String
  metadataJson   String?
  status         SigningSessionStatus @default(PENDING)
  expiresAt      DateTime

  signedAt       DateTime?
  signedById     String?
  signedBy       User?                @relation("UserSigningSessions", fields: [signedById], references: [id], onDelete: SetNull)
  signerName     String?
  signerRole     String?
  biometricType  String?              // TOUCH_ID, FACE_ID, WEBAUTHN
  deviceInfo     String?
  ipAddress      String?

  stampId        String?
  stamp          DocumentStamp?       @relation(fields: [stampId], references: [id], onDelete: SetNull)

  createdById    String
  createdBy      User                 @relation("CreatedSigningSessions", fields: [createdById], references: [id])

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([docNumber])
  @@index([createdById])
  @@index([stampId])
  @@index([status])
  @@map("signing_sessions")
}

enum BackupType {
  AUTOMATIC
  MANUAL
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  RESTORED
}

model BackupRecord {
  id            String       @id @default(uuid())
  filename      String
  filePath      String
  fileSizeBytes BigInt       @default(0)
  backupType    BackupType   @default(MANUAL)
  status        BackupStatus @default(COMPLETED)
  checksum      String?      // SHA-256 xesh
  notes         String?
  triggeredById String?
  triggeredBy   User?        @relation("UserBackups", fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([status])
  @@index([triggeredById])
  @@index([createdAt])
  @@map("backup_records")
}

model DepreciationRun {
  id                      String               @id @default(uuid())
  batchNumber             String               @unique // Masalan: DEP-2026-09-001
  period                  String               // Masalan: 2026-09
  totalAssetsCount        Int                  @default(0)
  totalDepreciationAmount Decimal              @default(0) @db.Decimal(14, 2)
  totalBookValue          Decimal              @default(0) @db.Decimal(14, 2)
  status                  String               @default("COMPLETED")
  notes                   String?
  executedById            String?
  executedBy              User?                @relation("DepreciationExecutors", fields: [executedById], references: [id], onDelete: SetNull)
  createdAt               DateTime             @default(now())

  records                 DepreciationRecord[]

  @@index([period])
  @@index([executedById])
  @@index([createdAt])
  @@map("depreciation_runs")
}

model DepreciationRecord {
  id                 String          @id @default(uuid())
  runId              String
  run                DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  assetId            String
  asset              ItemInstance    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  period             String          // Masalan: 2026-09
  initialCost        Decimal         @db.Decimal(12, 2)
  openingBookValue   Decimal         @db.Decimal(12, 2)
  depreciationAmount Decimal         @db.Decimal(12, 2)
  closingBookValue   Decimal         @db.Decimal(12, 2)
  accumulatedTotal   Decimal         @db.Decimal(12, 2)
  annualRate         Float           // Yillik stavka foizi (masalan 20.0)
  calculatedAt       DateTime        @default(now())

  @@unique([assetId, period])
  @@index([runId])
  @@index([assetId])
  @@index([period])
  @@map("depreciation_records")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique
  endpoint     String
  statusCode   Int      @default(200)
  responseJson String   @db.Text
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}

model DocumentSequence {
  id         String   @id @default(uuid())
  prefix     String   // REQ, MOV, INV, OS1, OS2, OS4, INV19, HF, SH, REP, TRF, AKT
  year       Int      // 2026
  currentVal Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([prefix, year])
  @@index([prefix, year])
  @@map("document_sequences")
}

enum HandoverType {
  FULL_TRANSFER
  PARTIAL_TRANSFER
  ROOM_TRANSFER
  RETURN_TO_WAREHOUSE
  FINAL_CLEARANCE
}

enum HandoverStatus {
  DRAFT
  SUBMITTED
  RECEIVER_REVIEW
  COMMANDANT_REVIEW
  ACCOUNTANT_REVIEW
  PENDING_APPROVAL
  PENDING_AUDIT
  PENDING_SIGNATURES
  COMPLETED
  REJECTED
  CANCELLED
}

enum HandoverItemActionType {
  TRANSFER_TO_MOL
  RETURN_TO_WAREHOUSE
  SEND_TO_REPAIR
  WRITE_OFF
  SHORTAGE
}

model ResponsibilityHandover {
  id                String                 @id @default(uuid())
  handoverNumber    String                 @unique // e.g. "ACT-2026-0001"
  type              HandoverType
  status            HandoverStatus         @default(DRAFT)

  // Ishtirokchilar
  departingUserId   String
  departingUser     User                   @relation("DepartingHandovers", fields: [departingUserId], references: [id])

  targetUserId      String?
  targetUser        User?                  @relation("TargetHandovers", fields: [targetUserId], references: [id])

  targetWarehouseId String?
  targetWarehouse   Warehouse?             @relation("WarehouseHandovers", fields: [targetWarehouseId], references: [id])

  buildingId        String?
  building          Building?              @relation("BuildingHandovers", fields: [buildingId], references: [id])

  commandantUserId  String?
  commandantUser    User?                  @relation("CommandantHandovers", fields: [commandantUserId], references: [id])

  accountantUserId  String?
  accountantUser    User?                  @relation("AccountantHandovers", fields: [accountantUserId], references: [id])

  approvedByUserId  String?
  approvedByUser    User?                  @relation("ApprovedHandovers", fields: [approvedByUserId], references: [id])

  roomId            String?
  room              Room?                  @relation("RoomHandovers", fields: [roomId], references: [id])

  note              String?
  docArchiveId      String?
  docArchive        DocumentArchive?       @relation("HandoverDocumentArchive", fields: [docArchiveId], references: [id])

  items             HandoverItemAction[]

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  completedAt       DateTime?

  @@index([departingUserId])
  @@index([targetUserId])
  @@index([buildingId])
  @@index([commandantUserId])
  @@index([accountantUserId])
  @@index([status])
  @@map("responsibility_handovers")
}

model HandoverItemAction {
  id                String                 @id @default(uuid())
  handoverId        String
  handover          ResponsibilityHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  itemInstanceId    String
  itemInstance      ItemInstance           @relation("HandoverItemInstances", fields: [itemInstanceId], references: [id])

  actionType        HandoverItemActionType
  targetUserId      String?
  targetWarehouseId String?

  conditionNote     String?                // Jihoz holati (Soz / Siniq / Topilmadi)
  investigationNote String?                // Kamomad bo'lsa komissiya xulosasi

  createdAt         DateTime               @default(now())

  @@index([handoverId])
  @@index([itemInstanceId])
  @@index([actionType])
  @@map("handover_item_actions")
}




