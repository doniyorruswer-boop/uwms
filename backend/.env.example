# ==============================================================================
# UWMS — Backend Muhit O'zgaruvchilari Namunalari (.env.example)
# ==============================================================================
# DIQQAT: Ushbu fayl faqat andoza hisoblanadi! Haqiqiy .env faylini repozitoriyga
# yoki ochiq arxivga yuklash QAT'IYAN TAQIQLANADI!
# Production muhitida ushbu andozadan nusxa olib (.env), quyidagi parametrlarni
# haqiqiy xavfsiz qiymatlar bilan to'ldiring.
# ==============================================================================

# 1. Server Porti
PORT=4000

# 2. Muhit Turi (development | production | test)
NODE_ENV=development

# 3. PostgreSQL Ma'lumotlar Bazasi Ulanish Satri (ACID Tranzaksiyalari)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uwms_db?schema=public"

# 4. Kriptografik JWT Secret (Maxfiy Kalit)
# ⚠️ MUHIM: Productionda standart yoki qisqa kalit ishlatish qat'iyan taqiqlangan!
# Kriptografik tasodifiy 512-bit kalit yaratish uchun quyidagi buyruqni bajaring:
#   npm run generate:secret
# yoki
#   node scripts/generate-jwt-secret.js
JWT_SECRET="CHANGE_ME_TO_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_TO_LONG_RANDOM_REFRESH_SECRET"

# 5. JWT Sessiya Amal Qilish Muddati
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 6. CORS Ruxsat Berilgan Frontend Domenlari
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# 7. HEMIS Axborot Tizimi Integratsiyasi (Oliy Ta’lim Muassasalari Standarti)
# Eslatma: Kalitlar olingunga qadar tizim xavfsiz sinov (demo) rejimida to‘liq ishlaydi.
# Kalitlar olingach:
#   HEMIS_API_URL="https://hemis.otm.uz/rest/v1"   # OTM yoki Vazirlik bergan endpoint
#   HEMIS_API_KEY="your-secret-bearer-token"
#   HEMIS_MODE="live"                             # demo | live
HEMIS_API_URL=
HEMIS_API_KEY=
HEMIS_MODE=demo

# 8. Hujjat va Fayllar Yuklanish Katalogi
# UPLOAD_DIR="./uploads"

# ==============================================================================
# 9. Test / Seed Foydalanuvchilari (Faqat dasturchilar/sinov muhiti uchun)
# Dastlabki `npm run prisma:seed` orqali bazaga kiritiladigan namunaviy hisoblar:
# Barcha sinov profillari uchun boshlang'ich sinov paroli: "admin123"
# (Eslatma: Tizim xavfsizlik siyosatiga ko'ra, birinchi kirishda yangi xavfsiz parol so'raladi)
#
# - Super Admin:        admin       / admin123
# - Bosh Omborchi:      warehouse   / admin123
# - Kafedra Mudiri:     mol         / admin123
# - O'qituvchi/Xodim:   teacher     / admin123
# - Ichki Auditor:      auditor     / admin123
# ==============================================================================

# ==============================================================================
# 10. Universitet Tashqi Zaxira Serveri (Disaster Recovery & Redundancy)
# ==============================================================================
# UWMS tashqi ommaviy AWS/Google Cloud S3 ga bog'liq emas. Zaxira nusxalari
# to'g'ridan-to'g'ri universitetning o'z ichki infratuzilmasidagi alohida
# xavfsiz serverga AES-256-GCM algoritmi bilan shifrlangan holda yuboriladi.
#
# 1-variant: Universitetning alohida fayl serveri / Tarmoq diski (Tavsiya etiladi)
# Masalan:
# Windows Network Share: UNIVERSITY_BACKUP_SERVER_PATH=\\backup-server.univ.uz\uwms_backups
# Linux NFS/Mount:       UNIVERSITY_BACKUP_SERVER_PATH=/mnt/university_backup_server/uwms
UNIVERSITY_BACKUP_SERVER_PATH=backups/university_server

# 2-variant: Universitetning ichki MinIO serveri (Agar OTM MinIO server o'rnatgan bo'lsa)
UNIVERSITY_MINIO_ENDPOINT=
UNIVERSITY_MINIO_BUCKET=uwms-backups
UNIVERSITY_MINIO_ACCESS_KEY=
UNIVERSITY_MINIO_SECRET_KEY=

# Zaxira nusxalarini AES-256 shifrlash kaliti (32 baytlik xavfsiz kalit)
BACKUP_ENCRYPTION_KEY=uwms_university_master_encryption_key_2026

