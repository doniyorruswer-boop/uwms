# ==============================================================================
# UWMS — Backend Muhit O'zgaruvchilari Namunalari (.env.example)
# ==============================================================================
# DIQQAT: Ushbu fayl faqat andoza hisoblanadi! Haqiqiy .env faylini repozitoriyga
# yoki ochiq arxivga yuklash QAT'IYAN TAQIQLANADI!
# Production muhitida ushbu andozadan nusxa olib (.env), quyidagi parametrlarni
# haqiqiy xavfsiz qiymatlar bilan to'ldiring.
# ==============================================================================

# 1. Server Porti
PORT=4000

# 2. Muhit Turi (development | production | test)
NODE_ENV=development

# 3. PostgreSQL Ma'lumotlar Bazasi Ulanish Satri (ACID Tranzaksiyalari)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uwms_db?schema=public"

# 4. Kriptografik JWT Secret (Maxfiy Kalit)
# ⚠️ MUHIM: Productionda standart yoki qisqa kalit ishlatish qat'iyan taqiqlangan!
# Kriptografik tasodifiy 512-bit kalit yaratish uchun quyidagi buyruqni bajaring:
#   npm run generate:secret
# yoki
#   node scripts/generate-jwt-secret.js
JWT_SECRET="generate_a_secure_64_byte_hex_secret_with_npm_run_generate_secret"

# 5. JWT Sessiya Amal Qilish Muddati (masalan: 1d, 7d, 24h)
JWT_EXPIRES_IN="7d"

# 6. CORS Ruxsat Berilgan Frontend Domenlari
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# 7. HEMIS Axborot Tizimi Integratsiyasi (Ixtiyoriy)
# OTM ning rasmiy HEMIS REST API endpointi va API kaliti
# HEMIS_MODE: 'LIVE' (haqiqiy API) yoki 'DEMO_STUB' (sinov andozasi)
HEMIS_MODE="DEMO_STUB"
# HEMIS_API_URL="https://hemis.edu.uz/api/v1"
# HEMIS_API_KEY="otm_hemis_token_here"

# 8. Hujjat va Fayllar Yuklanish Katalogi
# UPLOAD_DIR="./uploads"
